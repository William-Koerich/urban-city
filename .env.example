# URL pública do site — usada no sitemap, robots.txt e metadata (Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 (opcional). Deixe em branco pra não carregar o script.
# Só é carregado depois que o visitante aceita cookies no banner do site.
NEXT_PUBLIC_GA_ID=

# Meta Pixel (opcional). Mesma regra do GA acima.
NEXT_PUBLIC_META_PIXEL_ID=

# Credenciais do painel /metricas — OBRIGATÓRIO configurar em produção.
# Sem essas duas variáveis, o painel responde 503 pra todo mundo (fail-safe).
METRICAS_USER=
METRICAS_PASSWORD=

# Banco de métricas em produção (Vercel/serverless).
# Sem isso, o site usa um arquivo SQLite local (ótimo pra dev, mas o
# filesystem da Vercel é efêmero — os dados se perderiam a cada deploy).
# 1. Crie uma conta grátis em https://turso.tech
# 2. turso db create urbancity-metricas
# 3. turso db show urbancity-metricas --url        -> TURSO_DATABASE_URL
# 4. turso db tokens create urbancity-metricas      -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
